# This file is a template, not real configuration. Copy it to a new file named `.env`
# in this same folder, then fill in your own values. `.env` itself is never committed —
# only this example file is, so nobody accidentally publishes a real password or secret.
#
#   cp .env.example .env
#
# Every "change-me" or "placeholder" value below MUST be replaced before you run anything
# for real. The app will still start with the placeholders — Postgres just won't be secure,
# which is fine on your own laptop for local development, but never anywhere else.

NODE_ENV=development

# ── Database (Postgres) ──────────────────────────────────────────────────────
# These four lines describe the same database from two angles: the plain username/password/
# database name (used to start the Postgres container itself), and two full connection strings
# built from those same values (used by the actual application code). If you change the
# password, change it in all three places — they have to match.
#
# DATABASE_URL goes through pgBouncer (a connection pooler) on port 6532 — the running app
# always uses this one.
# DIRECT_URL talks to Postgres directly on port 5532, skipping the pooler — database
# migrations always use this one instead, because schema changes and connection pooling
# don't mix well.
POSTGRES_USER=opendarja
POSTGRES_PASSWORD=change-me-to-a-random-string
POSTGRES_DB=opendarja
DATABASE_URL="postgresql://opendarja:change-me-to-a-random-string@localhost:6532/opendarja?pgbouncer=true"
DIRECT_URL="postgresql://opendarja:change-me-to-a-random-string@localhost:5532/opendarja"

# ── CloudBeaver ───────────────────────────────────────────────────────────────
# A web-based database browser that runs alongside Postgres locally, so you can look at
# tables without installing a separate database client. Pick your own admin login for it.
CB_ADMIN_NAME=opendarja_admin
CB_ADMIN_PASSWORD=change-me-to-a-random-string

# ── Backend API (control-plane/backend) ────────────────────────────────────────
PORT=3000

# The secret key used to sign and verify login sessions (JWTs). Anyone who has this value
# can forge a valid login for any account, so it must be long, random, and never shared or
# committed. Generate one with the command below and paste the output here:
#   openssl rand -base64 32
AUTH_SECRET="generate-your-own-32-plus-character-secret"

# Which website address is allowed to call this API from a browser (CORS). In local
# development this is the frontend's own address.
CORS_ORIGIN="http://localhost:3001"

# A secret used to anonymise IP addresses before they're stored, so raw IPs are never kept.
# Same rule as AUTH_SECRET: random, private, never committed.
IP_HASH_SALT="placeholder-change-me"

# Redis is used for rate-limiting and short-lived session/cache data — not for the job queue,
# which runs on Postgres instead (see the technical guide if you're curious why).
REDIS_URL="redis://localhost:6379"

# Optional. If you have a Sentry project and want error reporting locally, paste its DSN
# here. Leave it blank to skip Sentry entirely — nothing breaks either way.
SENTRY_DSN=

# ── File storage (uploads, dataset exports) ────────────────────────────────────
# STORAGE_PROVIDER can be "local" (files saved to a folder on this machine — the default,
# no extra setup needed) or "r2" (Cloudflare R2, an S3-compatible bucket — needed for a
# real deployment, not for local development).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR="./.storage"
STORAGE_LOCAL_BASE_URL="http://localhost:3000"
STORAGE_LOCAL_SECRET="placeholder-change-me"

# Only needed if STORAGE_PROVIDER=r2. Leave these blank for local development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Frontend (Next.js) ──────────────────────────────────────────────────────────
# Where the frontend should send its API requests. In local development this points at
# the backend port above.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Named FRONTEND_PORT rather than PORT, on purpose — the backend already reads a variable
# called PORT above, and both processes read from this same file, so a plain PORT would
# collide between the two.
FRONTEND_PORT=3001

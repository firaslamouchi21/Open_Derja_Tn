{
  "name": "@open-derja/db",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "generate": "dotenv -e ../.env -- prisma generate --schema=schema.prisma",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy --schema=schema.prisma",
    "migrate:diff": "dotenv -e ../.env -- prisma migrate diff --schema=schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0"
  }
}

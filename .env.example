NODE_ENV=development

# Postgres / pgBouncer — read by devops/compose/docker-compose.local.yml (container
# credentials) and by DATABASE_URL/DIRECT_URL below (app connection strings). Keep
# POSTGRES_PASSWORD in sync with the password embedded in those two URLs.
POSTGRES_USER=opendarja
POSTGRES_PASSWORD=generate-a-real-password
POSTGRES_DB=opendarja
DATABASE_URL="postgresql://opendarja:generate-a-real-password@localhost:6532/opendarja?pgbouncer=true"
DIRECT_URL="postgresql://opendarja:generate-a-real-password@localhost:5532/opendarja"

# CloudBeaver (devops/compose/docker-compose.local.yml)
CB_ADMIN_NAME=opendarja_admin
CB_ADMIN_PASSWORD=generate-a-real-password

# control-plane/backend
PORT=3000
AUTH_SECRET="generate with: openssl rand -base64 32"
CORS_ORIGIN="http://localhost:3001"
IP_HASH_SALT="generate with: openssl rand -base64 32"
REDIS_URL="redis://localhost:6379"

# local | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR="./.storage"
STORAGE_LOCAL_BASE_URL="http://localhost:3000"
STORAGE_LOCAL_SECRET="generate with: openssl rand -base64 32"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# frontend — named FRONTEND_PORT, not PORT, since Next's CLI would otherwise collide
# with the backend's PORT above once both read from the same process.env
NEXT_PUBLIC_API_URL="http://localhost:3000"
FRONTEND_PORT=3001

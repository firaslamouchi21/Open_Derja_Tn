{
  "name": "@open-derja/worker",
  "private": true,
  "version": "0.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "DOTENV_CONFIG_PATH=../../.env node dist/main.js",
    "start:dev": "DOTENV_CONFIG_PATH=../../.env tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@open-derja/core": "workspace:*",
    "@open-derja/db": "workspace:*",
    "@open-derja/scrapers": "workspace:*",
    "dotenv": "^16.4.5",
    "pg-boss": "^10.1.5"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
